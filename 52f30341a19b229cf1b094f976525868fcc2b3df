    },
    {
      "unresolved": true,
      "key": {
        "uuid": "71e22bb2_411e0590",
        "filename": "/COMMIT_MSG",
        "patchSetId": 6
      },
      "lineNbr": 16,
      "author": {
        "id": 1002790
      },
      "writtenOn": "2026-10-28T07:37:33Z",
      "side": 1,
      "message": "I think this is [the PLDMSensors change](https://gerrit.openbmc.org/c/openbmc/entity-manager/+/86156), which adds `PLDMSensors` to the MCTP transport records. The design above proposes keeping such settings on a `PLDMTerminus` entry for the device on its board instead, since a device behind a bridge has no transport record of its own.",
      "parentUuid": "8f435801_551bc9a9",
      "range": {
        "startLine": 15,
        "startChar": 0,
        "endLine": 16,
        "endChar": 53
      },
      "revId": "52f30341a19b229cf1b094f976525868fcc2b3df",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
