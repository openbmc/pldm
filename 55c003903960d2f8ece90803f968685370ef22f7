      "writtenOn": "2026-11-10T06:27:05Z",
      "side": 1,
      "message": "Done. The instance ID of the in-flight QueryDeviceIdentifiers is tracked now, and removeFDs() unregisters that request before erasing the entry.",
      "parentUuid": "dc5f51d9_0bb9df81",
      "revId": "55c003903960d2f8ece90803f968685370ef22f7",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
