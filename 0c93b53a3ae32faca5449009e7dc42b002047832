      "side": 1,
      "message": "Shouldn\u0027t we be updating the version published on the D-Bus when this function is eventually called from `taskCOmpletionCallback` after an update finishes?",
      "revId": "0c93b53a3ae32faca5449009e7dc42b002047832",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
