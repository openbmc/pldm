      },
      "writtenOn": "2026-10-07T10:33:55Z",
      "side": 1,
      "message": "MinPowerCapValue/MaxPowerCapValue are writable on D-Bus, so this check alone can be widened from outside. If a client lowers MinPowerCapValue below the PDR minSettable, a PowerCap below minSettable passes this check and is sent via setNumericEffecterValue(). Suggest also checking the raw value from baseToRaw() against the PDR minSettable/maxSettable.",
      "range": {
        "startLine": 129,
        "startChar": 0,
        "endLine": 129,
        "endChar": 4
      },
      "revId": "ee3c850dbb702e55156378dd970dbb421a179f45",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
