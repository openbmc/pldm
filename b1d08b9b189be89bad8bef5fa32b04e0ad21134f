      "writtenOn": "2026-08-09T18:00:31Z",
      "side": 1,
      "message": "Why aren\u0027t we updating the ActivationProgress here?",
      "revId": "b1d08b9b189be89bad8bef5fa32b04e0ad21134f",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
