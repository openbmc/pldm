    {
      "unresolved": false,
      "key": {
        "uuid": "7be790f8_9ce404f0",
        "filename": "fw-update/device_updater.cpp",
        "patchSetId": 5
      },
      "lineNbr": 590,
      "author": {
        "id": 1002605
      },
      "writtenOn": "2026-08-14T11:42:27Z",
      "side": 1,
      "message": "a failed component hasn\u0027t progressed, so advancing it would misreport progress. Instead it\u0027s reconciled at the device level: updateDeviceCompletion() calls markProgressComplete() + updateActivationProgress() (change https://gerrit.openbmc.org/c/openbmc/pldm/+/93481), so ActivationProgress still reaches 100% on a failed device without faking component progress.\nThe component-cancel path is handled separately by https://gerrit.openbmc.org/c/openbmc/pldm/+/93532, which adds a terminal UpdateProgress::state for cancellation that reports full progress.",
      "parentUuid": "587c3bcc_06cd189a",
      "revId": "b1d08b9b189be89bad8bef5fa32b04e0ad21134f",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
